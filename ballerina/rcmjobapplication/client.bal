    remote isolated function updateJobApplication(int applicationId, UpdateJobApplicationPayload payload, map<string|string[]> headers = {}) returns error? {
        string resourcePath = string `/JobApplication(${getEncodedUri(applicationId)})`;
        http:Request request = new;
        json jsonBody = jsondata:toJson(payload);
        request.setPayload(jsonBody, "application/json");
        return self.clientEp->put(resourcePath, request, headers);
    }

    # Invoke action sendEmailToInterviewers
    #
    # + headers - Headers to be sent with the request 
    # + queries - Queries to be sent with the request 
    # + return - Success 
    remote isolated function sendEmailToInterviewers(map<string|string[]> headers = {}, *SendEmailToInterviewersQueries queries) returns SendEmailToInterviewersResponse|error {
        string resourcePath = string `/sendEmailToInterviewers`;
        resourcePath = resourcePath + check getPathForQueryParam(queries);
        http:Request request = new;
        return self.clientEp->post(resourcePath, request, headers);
    }
}
